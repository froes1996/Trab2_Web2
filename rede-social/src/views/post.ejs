<!doctype html>
<html lang="pt-br">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Aula 05 - Post</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
      .carousel-container { position: relative; overflow: hidden; width: 100%; border-radius: 0.5rem; }
      .carousel-track { display: flex; transition: transform 0.3s ease-in-out; }
      .carousel-track img { width: 100%; flex-shrink: 0; object-fit: cover; max-height: 25rem; }
      .carousel-btn { position: absolute; top: 50%; transform: translateY(-50%); background: rgba(0,0,0,0.5); color: white; border: none; padding: 0.5rem; cursor: pointer; border-radius: 9999px; }
      .carousel-btn.prev { left: 0.5rem; }
      .carousel-btn.next { right: 0.5rem; }
    </style>
  </head>
  <body class="bg-slate-100 min-h-screen">
    <% const comments = post.comments ?? []; %>
    <% const likeCount = post._count?.likes ?? 0; %>
    <% const likedByMe = post.likes?.some(l => l.userId === currentUser.id) ?? false; %>

    <header class="bg-slate-900 text-white px-6 py-4 flex items-center justify-between sticky top-0 z-50">
      <h1 class="text-lg font-semibold">Post de <%= post.author.name %></h1>
      <a href="/" class="text-slate-300 text-sm hover:text-white">&larr; Voltar para o feed</a>
    </header>

    <main class="max-w-2xl mx-auto mt-8 px-4 flex flex-col gap-4" id="post-view-container">
      <article class="bg-white rounded-lg shadow p-4" data-post-id="<%= post.id %>">
        <header class="flex items-center justify-between">
          <p class="text-sm font-medium text-slate-800"><%= post.author.name %></p>
          <p class="text-xs text-slate-400"><%= new Date(post.createdAt).toLocaleString('pt-BR') %></p>
        </header>
        <p class="text-slate-700 mt-2"><%= post.content %></p>
        
        <!-- Carrossel de Imagens do Post -->
        <% if (post.images && post.images.length > 0) { %>
          <div class="mt-3 carousel-container" data-current-index="0" data-total="<%= post.images.length %>">
            <div class="carousel-track">
              <% post.images.forEach((img) => { %>
                <img src="<%= img.url %>" alt="Imagem do post" />
              <% }) %>
            </div>
            <% if (post.images.length > 1) { %>
              <button type="button" class="carousel-btn prev hidden">&#10094;</button>
              <button type="button" class="carousel-btn next">&#10095;</button>
            <% } %>
          </div>
        <% } %>

        <% if (post.tags.length > 0) { %>
          <div class="flex gap-2 mt-3 flex-wrap">
            <% post.tags.forEach((tag) => { %>
              <span class="text-xs bg-slate-100 text-slate-600 rounded-full px-2 py-0.5">#<%= tag.name %></span>
            <% }) %>
          </div>
        <% } %>
        
        <footer class="flex items-center gap-4 mt-3 pt-3 border-t border-slate-100">
          <button type="button" title="Curtir Post" class="like-post-btn flex items-center gap-1.5 text-sm <%= likedByMe ? 'text-rose-600' : 'text-slate-500' %> hover:text-rose-600" data-liked="<%= likedByMe %>">
            <svg viewBox="0 0 24 24" class="w-5 h-5 like-icon" fill="<%= likedByMe ? 'currentColor' : 'none' %>" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" />
            </svg>
            <span class="like-count"><%= likeCount %></span>
          </button>
          
          <span class="flex items-center gap-1.5 text-sm text-slate-500">
            <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 9.75h6.75m-6.75 3h4.5M12 20.25c4.97 0 9-3.694 9-8.25s-4.03-8.25-9-8.25-9 3.694-9 8.25c0 1.6.497 3.096 1.356 4.36.1.148.14.33.107.507l-.713 3.133 3.94-1.02c.16-.042.33-.02.48.043 1.15.49 2.45.767 3.83.767Z" />
            </svg>
            <span id="comment-count"><%= comments.length %></span>
          </span>
          
          <% if (post.authorId === currentUser.id) { %>
            <form method="post" action="/posts/<%= post.id %>/delete" class="ml-auto">
              <button type="submit" class="text-xs text-red-600 hover:underline">Apagar</button>
            </form>
          <% } %>
        </footer>
      </article>

      <section class="bg-white rounded-lg shadow p-4">
        <h2 class="text-slate-500 text-sm font-medium uppercase tracking-wide">Comentários</h2>

        <form id="comment-form" class="flex flex-col gap-2 mt-3" data-post-id="<%= post.id %>">
          <p id="comment-error" class="bg-red-50 text-red-700 text-sm rounded px-3 py-2 hidden"></p>
          <textarea name="content" required rows="2" placeholder="Escreva um comentário..." class="w-full border rounded px-3 py-2 text-sm"></textarea>
          <button type="submit" class="self-end bg-slate-800 text-white text-sm rounded px-3 py-1.5 hover:bg-slate-700">
            Comentar
          </button>
        </form>

        <div id="comments-list" class="divide-y mt-2">
          <% if (comments.length === 0) { %>
            <p id="empty-comments-msg" class="text-sm text-slate-500 py-3">Nenhum comentário ainda. Seja o primeiro.</p>
          <% } %>
          
          <% comments.forEach((comment) => { %>
            <% const commentLikedByMe = comment.likes?.some(l => l.userId === currentUser.id) ?? false; %>
            <div class="py-3 comment-item" data-comment-id="<%= comment.id %>">
              <div class="flex items-center justify-between">
                <p class="text-sm font-medium text-slate-800"><%= comment.author.name %></p>
                <p class="text-xs text-slate-400"><%= new Date(comment.createdAt).toLocaleString('pt-BR') %></p>
              </div>
              <p class="text-sm text-slate-700 mt-1"><%= comment.content %></p>
              
              <div class="mt-2 flex gap-4">
                <button type="button" class="like-comment-btn flex items-center gap-1 text-xs <%= commentLikedByMe ? 'text-rose-600' : 'text-slate-500' %> hover:text-rose-600" data-liked="<%= commentLikedByMe %>">
                  <svg viewBox="0 0 24 24" class="w-4 h-4 like-icon" fill="<%= commentLikedByMe ? 'currentColor' : 'none' %>" stroke="currentColor" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" />
                  </svg>
                  <span class="like-count"><%= comment._count?.likes ?? 0 %></span>
                </button>
              </div>
            </div>
          <% }) %>
        </div>
      </section>
    </main>

    <script>
      const container = document.getElementById('post-view-container');
      const commentForm = document.getElementById('comment-form');
      const commentsList = document.getElementById('comments-list');
      const commentCountSpan = document.getElementById('comment-count');
      const emptyMsg = document.getElementById('empty-comments-msg');
      const errorMsg = document.getElementById('comment-error');

      // 1. Delegação de Eventos para Likes (Post, Comments e Carrossel)
      container.addEventListener('click', async (e) => {
        // --- Like no Post ---
        const likePostBtn = e.target.closest('.like-post-btn');
        if (likePostBtn) {
          e.preventDefault();
          if(likePostBtn.disabled) return;
          const article = likePostBtn.closest('article');
          const postId = article.dataset.postId;
          handleOptimisticLike(likePostBtn, `/api/posts/${postId}/like`);
        }

        // --- Like no Comentário ---
        const likeCommentBtn = e.target.closest('.like-comment-btn');
        if (likeCommentBtn) {
          e.preventDefault();
          if(likeCommentBtn.disabled) return;
          const commentId = likeCommentBtn.closest('.comment-item').dataset.commentId;
          handleOptimisticLike(likeCommentBtn, `/api/comments/${commentId}/like`);
        }

        // --- Carrossel ---
        const prevBtn = e.target.closest('.carousel-btn.prev');
        const nextBtn = e.target.closest('.carousel-btn.next');
        if (prevBtn || nextBtn) {
          const carouselContainer = (prevBtn || nextBtn).closest('.carousel-container');
          const track = carouselContainer.querySelector('.carousel-track');
          let currentIndex = parseInt(carouselContainer.dataset.currentIndex, 10);
          const total = parseInt(carouselContainer.dataset.total, 10);
          if (prevBtn && currentIndex > 0) currentIndex--;
          if (nextBtn && currentIndex < total - 1) currentIndex++;
          carouselContainer.dataset.currentIndex = currentIndex;
          track.style.transform = `translateX(-${currentIndex * 100}%)`;
          carouselContainer.querySelector('.prev').classList.toggle('hidden', currentIndex === 0);
          carouselContainer.querySelector('.next').classList.toggle('hidden', currentIndex === total - 1);
        }
      });

      // Lógica reutilizável para update otimista de Likes (Post/Comment)
      async function handleOptimisticLike(btn, endpoint) {
        const isLiked = btn.dataset.liked === 'true';
        const icon = btn.querySelector('.like-icon');
        const countSpan = btn.querySelector('.like-count');
        let count = parseInt(countSpan.textContent, 10);

        btn.dataset.liked = !isLiked;
        countSpan.textContent = isLiked ? count - 1 : count + 1;
        icon.setAttribute('fill', isLiked ? 'none' : 'currentColor');
        btn.classList.toggle('text-rose-600', !isLiked);
        btn.classList.toggle('text-slate-500', isLiked);
        btn.disabled = true;

        try {
          const res = await fetch(endpoint, { method: 'POST' });
          if (!res.ok) throw new Error('Falha');
        } catch (err) {
          alert('Erro ao curtir. Tente novamente.');
          btn.dataset.liked = isLiked;
          countSpan.textContent = count;
          icon.setAttribute('fill', isLiked ? 'currentColor' : 'none');
          btn.classList.toggle('text-rose-600', isLiked);
          btn.classList.toggle('text-slate-500', !isLiked);
        } finally {
          btn.disabled = false;
        }
      }

      // 2. Envio de Comentário via Fetch (Sem Recarregar)
      commentForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        errorMsg.classList.add('hidden');
        const submitBtn = commentForm.querySelector('button[type="submit"]');
        submitBtn.disabled = true;

        const postId = commentForm.dataset.postId;
        const content = commentForm.content.value.trim();

        try {
          const res = await fetch(`/api/posts/${postId}/comments`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ content })
          });

          if (!res.ok) {
            const data = await res.json();
            throw new Error(data.message || 'Erro ao enviar comentário');
          }

          const newComment = await res.json();
          commentForm.reset();

          if (emptyMsg) emptyMsg.remove();

          const commentDiv = document.createElement('div');
          commentDiv.className = 'py-3 comment-item';
          commentDiv.dataset.commentId = newComment.id;
          commentDiv.innerHTML = `
            <div class="flex items-center justify-between">
              <p class="text-sm font-medium text-slate-800">${newComment.author.name}</p>
              <p class="text-xs text-slate-400">Agora mesmo</p>
            </div>
            <p class="text-sm text-slate-700 mt-1">${newComment.content}</p>
            <div class="mt-2 flex gap-4">
              <button type="button" class="like-comment-btn flex items-center gap-1 text-xs text-slate-500 hover:text-rose-600" data-liked="false">
                <svg viewBox="0 0 24 24" class="w-4 h-4 like-icon" fill="none" stroke="currentColor" stroke-width="1.8">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" />
                </svg>
                <span class="like-count">0</span>
              </button>
            </div>
          `;
          
          // Adiciona o novo comentário ao topo da lista
          commentsList.insertAdjacentElement('afterbegin', commentDiv);
          
          // Atualiza a contagem visual
          commentCountSpan.textContent = parseInt(commentCountSpan.textContent, 10) + 1;

        } catch (err) {
          errorMsg.textContent = err.message;
          errorMsg.classList.remove('hidden');
        } finally {
          submitBtn.disabled = false;
        }
      });
    </script>
  </body>
</html>