<!doctype html>
<html lang="pt-br">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Aula 05 - Feed</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
      .carousel-container { position: relative; overflow: hidden; width: 100%; border-radius: 0.5rem; }
      .carousel-track { display: flex; transition: transform 0.3s ease-in-out; }
      .carousel-track img { width: 100%; flex-shrink: 0; object-fit: cover; max-height: 20rem; }
      .carousel-btn { position: absolute; top: 50%; transform: translateY(-50%); background: rgba(0,0,0,0.5); color: white; border: none; padding: 0.5rem; cursor: pointer; border-radius: 9999px; }
      .carousel-btn.prev { left: 0.5rem; }
      .carousel-btn.next { right: 0.5rem; }
    </style>
  </head>
  <body class="bg-slate-100 min-h-screen">
    <header class="bg-slate-900 text-white px-6 py-4 flex items-center justify-between sticky top-0 z-50">
      <div class="flex items-center gap-3">
        <% if (currentUser.avatarUrl) { %>
          <img src="<%= currentUser.avatarUrl %>" alt="" class="w-9 h-9 rounded-full object-cover" />
        <% } %>
        <div>
          <h1 class="text-lg font-semibold">Rede social — Aula 05</h1>
          <p class="text-slate-300 text-sm">
            Logado como <strong><%= currentUser.name %></strong>
            (<%= currentUser._count.following %> seguindo, <%= currentUser._count.followers %> seguidores)
          </p>
        </div>
      </div>
      <div class="flex items-center gap-3">
        <a href="/posts/new" class="bg-white text-slate-900 text-sm rounded px-3 py-1.5 hover:bg-slate-200">Novo post</a>
        <form method="post" action="/logout">
          <button type="submit" class="text-slate-300 text-sm hover:text-white">Sair</button>
        </form>
      </div>
    </header>

    <main class="max-w-4xl mx-auto mt-8 px-4 grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- O ID do utilizador é injetado aqui via data-attribute para o JS ler sem erros de sintaxe -->
      <section class="md:col-span-2 flex flex-col gap-4" id="feed-container" data-user-id="<%= currentUser.id %>">
        <h2 class="text-slate-500 text-sm font-medium uppercase tracking-wide">Seu feed</h2>

        <% if (feed.length === 0) { %>
          <p class="bg-white rounded-lg shadow p-6 text-sm text-slate-500" id="empty-feed-msg">
            Ninguém que você segue postou ainda. Siga alguém na coluna ao lado.
          </p>
        <% } %>

        <% feed.forEach((post) => { %>
          <% const likeCount = post._count?.likes ?? 0; %>
          <% const commentCount = post._count?.comments ?? 0; %>
          <% const likedByMe = post.likes?.some(l => l.userId === currentUser.id) ?? false; %>
          <article class="bg-white rounded-lg shadow p-4 post-article" data-post-id="<%= post.id %>">
            <header class="flex items-center justify-between">
              <p class="text-sm font-medium text-slate-800"><%= post.author.name %></p>
              <p class="text-xs text-slate-400"><%= new Date(post.createdAt).toLocaleString('pt-BR') %></p>
            </header>
            
            <a href="/posts/<%= post.id %>" class="block group">
              <p class="text-slate-700 mt-2 group-hover:text-slate-900"><%= post.content %></p>
            </a>

            <!-- Carrossel de Imagens -->
            <% if (post.images && post.images.length > 0) { %>
              <div class="mt-3 carousel-container" data-current-index="0" data-total="<%= post.images.length %>">
                <div class="carousel-track">
                  <% post.images.forEach((img) => { %>
                    <img src="<%= img.url %>" alt="Imagem do post" />
                  <% }) %>
                </div>
                <% if (post.images.length > 1) { %>
                  <button type="button" class="carousel-btn prev hidden">&#10094;</button>
                  <button type="button" class="carousel-btn next">&#10095;</button>
                <% } %>
              </div>
            <% } %>

            <% if (post.tags.length > 0) { %>
              <div class="flex gap-2 mt-3 flex-wrap">
                <% post.tags.forEach((tag) => { %>
                  <span class="text-xs bg-slate-100 text-slate-600 rounded-full px-2 py-0.5">#<%= tag.name %></span>
                <% }) %>
              </div>
            <% } %>

            <footer class="flex items-center gap-4 mt-3 pt-3 border-t border-slate-100">
              <!-- Botão Like Fetch (Atualização Otimista e Delegação) -->
              <button
                type="button"
                title="Curtir"
                class="like-btn flex items-center gap-1.5 text-sm <%= likedByMe ? 'text-rose-600' : 'text-slate-500' %> hover:text-rose-600"
                data-post-id="<%= post.id %>"
                data-liked="<%= likedByMe %>"
              >
                <svg viewBox="0 0 24 24" class="w-5 h-5 like-icon" fill="<%= likedByMe ? 'currentColor' : 'none' %>" stroke="currentColor" stroke-width="1.8">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" />
                </svg>
                <span class="like-count"><%= likeCount %></span>
              </button>

              <a href="/posts/<%= post.id %>" title="Comentários" class="flex items-center gap-1.5 text-sm text-slate-500 hover:text-slate-800">
                <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 9.75h6.75m-6.75 3h4.5M12 20.25c4.97 0 9-3.694 9-8.25s-4.03-8.25-9-8.25-9 3.694-9 8.25c0 1.6.497 3.096 1.356 4.36.1.148.14.33.107.507l-.713 3.133 3.94-1.02c.16-.042.33-.02.48.043 1.15.49 2.45.767 3.83.767Z" />
                </svg>
                <span><%= commentCount %></span>
              </a>

              <% if (post.authorId === currentUser.id) { %>
                <form method="post" action="/posts/<%= post.id %>/delete" class="ml-auto">
                  <button type="submit" class="text-xs text-red-600 hover:underline">Apagar</button>
                </form>
              <% } %>
            </footer>
          </article>
        <% }) %>
        
        <!-- Elemento âncora para o Scroll Infinito -->
        <div id="infinite-scroll-trigger" class="py-4 text-center text-slate-500 text-sm hidden">Carregando mais posts...</div>
      </section>

      <aside class="flex flex-col gap-3">
        <h2 class="text-slate-500 text-sm font-medium uppercase tracking-wide">Pessoas</h2>
        <div class="bg-white rounded-lg shadow divide-y">
          <% others.forEach((user) => { %>
            <div class="flex items-center justify-between px-4 py-3">
              <span class="text-sm text-slate-700"><%= user.name %></span>
              <% if (user.isFollowing) { %>
                <span class="text-xs text-slate-400">Já segue</span>
              <% } else { %>
                <form method="post" action="/follow">
                  <input type="hidden" name="targetId" value="<%= user.id %>" />
                  <button type="submit" class="text-xs bg-slate-800 text-white rounded px-2 py-1 hover:bg-slate-700">Seguir</button>
                </form>
              <% } %>
            </div>
          <% }) %>
        </div>
      </aside>
    </main>

    <script>
      const feedContainer = document.getElementById('feed-container');
      // Lemos o ID do data-attribute injetado pelo HTML, mantendo o JS 100% puro
      const myUserId = parseInt(feedContainer.dataset.userId, 10);

      // 1. DELEGAÇÃO DE EVENTOS PARA LIKES E CARROSSEL
      feedContainer.addEventListener('click', async (e) => {
        // --- LÓGICA DE LIKE (Optimistic UI) ---
        const likeBtn = e.target.closest('.like-btn');
        if (likeBtn) {
          e.preventDefault();
          if(likeBtn.disabled) return;
          
          const postId = likeBtn.dataset.postId;
          const isLikedStr = likeBtn.dataset.liked;
          const isLiked = isLikedStr === 'true';
          const icon = likeBtn.querySelector('.like-icon');
          const countSpan = likeBtn.querySelector('.like-count');
          let count = parseInt(countSpan.textContent, 10);

          // Atualização Otimista Visual
          likeBtn.dataset.liked = !isLiked;
          if (!isLiked) {
            count++;
            icon.setAttribute('fill', 'currentColor');
            likeBtn.classList.replace('text-slate-500', 'text-rose-600');
          } else {
            count--;
            icon.setAttribute('fill', 'none');
            likeBtn.classList.replace('text-rose-600', 'text-slate-500');
          }
          countSpan.textContent = count;
          likeBtn.disabled = true;

          try {
            const res = await fetch(`/api/posts/${postId}/like`, { method: 'POST' });
            if (!res.ok) throw new Error('Falha na rede');
          } catch (err) {
            alert('Erro ao curtir post. Tente novamente.');
            likeBtn.dataset.liked = isLiked;
            countSpan.textContent = isLiked ? count + 1 : count - 1;
            icon.setAttribute('fill', isLiked ? 'currentColor' : 'none');
            if (isLiked) {
              likeBtn.classList.replace('text-slate-500', 'text-rose-600');
            } else {
              likeBtn.classList.replace('text-rose-600', 'text-slate-500');
            }
          } finally {
            likeBtn.disabled = false;
          }
        }

        // --- LÓGICA DO CARROSSEL ---
        const prevBtn = e.target.closest('.carousel-btn.prev');
        const nextBtn = e.target.closest('.carousel-btn.next');
        
        if (prevBtn || nextBtn) {
          const container = (prevBtn || nextBtn).closest('.carousel-container');
          const track = container.querySelector('.carousel-track');
          let currentIndex = parseInt(container.dataset.currentIndex, 10);
          const total = parseInt(container.dataset.total, 10);

          if (prevBtn && currentIndex > 0) currentIndex--;
          if (nextBtn && currentIndex < total - 1) currentIndex++;

          container.dataset.currentIndex = currentIndex;
          track.style.transform = `translateX(-${currentIndex * 100}%)`;

          container.querySelector('.prev').classList.toggle('hidden', currentIndex === 0);
          container.querySelector('.next').classList.toggle('hidden', currentIndex === total - 1);
        }
      });

      // 2. SCROLL INFINITO (IntersectionObserver)
      const trigger = document.getElementById('infinite-scroll-trigger');
      let isLoading = false;
      let hasMore = true;

      if (document.querySelectorAll('.post-article').length >= 10) {
        trigger.classList.remove('hidden');
      } else {
        hasMore = false;
      }

      const observer = new IntersectionObserver(async (entries) => {
        if (entries[0].isIntersecting && !isLoading && hasMore) {
          isLoading = true;
          
          const articles = document.querySelectorAll('.post-article');
          const lastArticle = articles[articles.length - 1];
          const cursorId = lastArticle ? lastArticle.dataset.postId : null;

          if (!cursorId) return;

          try {
            const res = await fetch(`/api/feed?cursor=${cursorId}&limit=10`);
            const nextPosts = await res.json();

            if (nextPosts.length < 10) {
              hasMore = false;
              trigger.textContent = "Fim dos posts.";
            }

            nextPosts.forEach(post => {
              const likedByMe = post.likes?.some(l => l.userId === myUserId) ?? false;
              const imagesHtml = post.images && post.images.length > 0 ? `
                <div class="mt-3 carousel-container" data-current-index="0" data-total="${post.images.length}">
                  <div class="carousel-track">
                    ${post.images.map(img => `<img src="${img.url}" alt="Imagem do post" />`).join('')}
                  </div>
                  ${post.images.length > 1 ? `
                    <button type="button" class="carousel-btn prev hidden">&#10094;</button>
                    <button type="button" class="carousel-btn next">&#10095;</button>
                  ` : ''}
                </div>
              ` : '';

              const article = document.createElement('article');
              article.className = "bg-white rounded-lg shadow p-4 post-article mt-4";
              article.dataset.postId = post.id;
              article.innerHTML = `
                <header class="flex items-center justify-between">
                  <p class="text-sm font-medium text-slate-800">${post.author.name}</p>
                  <p class="text-xs text-slate-400">${new Date(post.createdAt).toLocaleString('pt-BR')}</p>
                </header>
                <a href="/posts/${post.id}" class="block group">
                  <p class="text-slate-700 mt-2 group-hover:text-slate-900">${post.content}</p>
                </a>
                ${imagesHtml}
                <footer class="flex items-center gap-4 mt-3 pt-3 border-t border-slate-100">
                  <button type="button" title="Curtir" class="like-btn flex items-center gap-1.5 text-sm ${likedByMe ? 'text-rose-600' : 'text-slate-500'} hover:text-rose-600" data-post-id="${post.id}" data-liked="${likedByMe}">
                    <svg viewBox="0 0 24 24" class="w-5 h-5 like-icon" fill="${likedByMe ? 'currentColor' : 'none'}" stroke="currentColor" stroke-width="1.8">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" />
                    </svg>
                    <span class="like-count">${post._count?.likes ?? 0}</span>
                  </button>
                  <a href="/posts/${post.id}" title="Comentários" class="flex items-center gap-1.5 text-sm text-slate-500 hover:text-slate-800">
                    <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 9.75h6.75m-6.75 3h4.5M12 20.25c4.97 0 9-3.694 9-8.25s-4.03-8.25-9-8.25-9 3.694-9 8.25c0 1.6.497 3.096 1.356 4.36.1.148.14.33.107.507l-.713 3.133 3.94-1.02c.16-.042.33-.02.48.043 1.15.49 2.45.767 3.83.767Z" />
                    </svg>
                    <span>${post._count?.comments ?? 0}</span>
                  </a>
                </footer>
              `;
              trigger.parentNode.insertBefore(article, trigger);
            });
          } catch (err) {
            console.error('Erro ao carregar mais posts', err);
          } finally {
            isLoading = false;
          }
        }
      });

      observer.observe(trigger);
    </script>
  </body>
</html>